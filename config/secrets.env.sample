# Secrets (ntfy topic / auth) — cmd_213
# FR-066: ntfy認証対応
#
# 置場(リポジトリ外・git対象外):
#   ~/.config/multi-agent-shogun/secrets.env
#   (環境変数 SHOGUN_SECRETS_FILE でパスを上書き可 — テスト・隔離用)
#
# Usage:
#   1. mkdir -p ~/.config/multi-agent-shogun
#   2. cp config/secrets.env.sample ~/.config/multi-agent-shogun/secrets.env
#   3. chmod 600 ~/.config/multi-agent-shogun/secrets.env   # 所有者のみ読み書き(推奨)
#   4. 下の値を埋める
#
# 形式: `KEY=value` を1行ずつ。スクリプトはこのファイルを source せず行をパースして
# 必要なキーだけ読む(余計な式は実行されない)。値にクォートは不要(付けても外される)。
# クォートなしの値は行末の ` #...`(空白+#以降)がコメントとして無視される。クォート内の # は値の一部。
#
# このファイルの実値を、リポジトリ・ログ・報告書・commit message に書かない。
# 読み手(scripts/ntfy.sh, scripts/ntfy_listener.sh, shutsujin_departure.sh,
# lib/branch_policy.sh)はこのファイルのみを見る(旧 config/ntfy_auth.env や
# settings.yaml の ntfy_topic への fallback は無い)。

# --- ntfy topic (必須) ---
# 通知チャンネルの事実上のアクセストークン。推測困難なランダム文字列(12文字以上)にすること。
# 空または未設定だと scripts/ntfy.sh は stderr にエラーを出して非0終了する(fail-loud)。
NTFY_TOPIC=

# NOTE: The public ntfy.sh instance does NOT support authentication.
#       Token/Basic auth requires a self-hosted ntfy server.
#       See: https://docs.ntfy.sh/config/#access-control

# --- Bearer Token Auth (recommended for self-hosted ntfy) ---
# Generate with: ntfy token add <username>
# Format: tk_ followed by 29 alphanumeric chars
# NTFY_TOKEN=tk_your_token_here

# --- Basic Auth (alternative for self-hosted ntfy) ---
# NTFY_USER=your_username
# NTFY_PASS=your_password

# Priority: Token > Basic > None
# If neither is set, no auth headers are sent (backward compatible with public ntfy.sh)
