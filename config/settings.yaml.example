# Settings example (cmd_149)
#
# Usage:
#   1. Copy this file to config/settings.yaml
#   2. Fill in every <placeholder> with your own value
#   3. config/settings.yaml is NOT tracked by git (whitelist .gitignore,
#      explicit deny)
#   4. Secrets (ntfy topic / auth) do NOT live here — see config/secrets.env.sample
#      (cmd_213: ~/.config/multi-agent-shogun/secrets.env, outside the repo)
#
# This file mirrors the full key structure of config/settings.yaml but
# contains no real operational values — see each project doc / instructions/
# for the meaning and recommended defaults of each key.

features:
  yaml_guard_enabled: <off|observe|enforce>
  reporting_mode: <exception|verbose>
  reversibility_check_enabled: <off|observe>
  parent_cmd_done_gate_enabled: <off|observe|enforce>
auto_heal:
  silent_heal_enabled: <true|false>
  escalation_window_minutes: <integer>
  escalation_threshold_count: <integer>
  cooldown_after_escalation_minutes: <integer>
dashboard_staleness:
  enabled: <boolean>
  hours: <integer>
  check_interval_minutes: <integer>
  cooldown_after_escalation_minutes: <integer>
assignment_grace:
  after_nudge_seconds: <integer>
busy_guard:  # cmd_231: 働き中の足軽へ /clear は送らぬ。働き中が長く続くときは殿へ ntfy で知らせる(既定=将軍案。無ければこの既定で動く)
  unread_notify_minutes: 30  # 働き中のまま未読が残る分数 → 知らせ
  continuous_notify_minutes: 60  # 未読の有無を問わず働き中が連続する分数 → 知らせ
  repeat_notify_minutes: 60  # 知らせた後、続く間の再通知間隔
  confirm_repeat_notify_minutes: 30  # cmd_231 工程B: 確認画面で止まった足軽は待たず即時に1回知らせ、同じ画面が続く間はこの分ごとに1回
  # 確認画面の検出文言(ERE・大小無視)。Claude Code の画面文言が変わったらここで差し替える。無ければ既定で動く。
  # ※ 既定値は模擬画面での確認のみ(実機未確認)。誤記(ERE として不正)は既定へ戻る。
  # confirm_screen_regex: 'Esc to cancel|Do you want to |\(y/n\)|\[Y/n\]|\[y/N\]|[0-9]+\.[[:space:]]+(Yes|No)([[:space:]]|,|$)|Press Enter to|Enter to confirm'
cli:
  agents:
    karo:
      type: <claude|codex|opencode|copilot|kimi>
      model: <model-id>
      effort: <low|medium|high>
    ashigaru1:
      type: <claude|codex|opencode|copilot|kimi>
      model: <model-id>
      effort: <low|medium|high>
    ashigaru2:
      type: <claude|codex|opencode|copilot|kimi>
      model: <model-id>
      effort: <low|medium|high>
    ashigaru3:
      type: <claude|codex|opencode|copilot|kimi>
      model: <model-id>
      effort: <low|medium|high>
    ashigaru4:
      type: <claude|codex|opencode|copilot|kimi>
      model: <model-id>
      effort: <low|medium|high>
    ashigaru5:
      type: <claude|codex|opencode|copilot|kimi>
      model: <model-id>
      effort: <low|medium|high>
    ashigaru6:
      type: <claude|codex|opencode|copilot|kimi>
      model: <model-id>
    ashigaru7:
      type: <claude|codex|opencode|copilot|kimi>
      model: <model-id>
    gunshi:
      type: <claude|codex|opencode|copilot|kimi>
      model: <model-id>
      effort: <low|medium|high>
    shogun:
      model: <model-id>
      type: <claude|codex|opencode|copilot|kimi>
      effort: <low|medium|high>
      mods:  # optional (claude only): Mod dirs loaded via --plugin-dir, relative to project root. Remove this key to unload (then restart the agent).
        - mods/status
        - mods/audit  # cmd_224: audit log; declare mods/audit for every agent (karo, gunshi, ashigaru1-7 too)
  default: <claude|codex|opencode|copilot|kimi>
language: <ja|en>
# ntfy topic: 値は ~/.config/multi-agent-shogun/secrets.env の NTFY_TOPIC (settings.yamlには書かない)
logging:
  level: <debug|info|warn|error>
  path: <absolute-path-to-logs-dir>
shell: <bash|zsh>
skill:
  local_path: <absolute-path-to-skills-dir>
  save_path: <absolute-path-to-claude-skills-dir>
